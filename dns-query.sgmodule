#!name=DNS-QUERY
#!desc=通过 DoH 解析域名，支持 ECS 与可选代理策略，并提供信息面板和网页统计
#!category=DNS
#!arguments=type:dual,doh:"https://8.8.4.4/dns-query",ttl:"",timeout:2,edns:"114.114.114.114",fallback:1,log:0,policy:0,flush_n:8,flush_ms:3000,ring:80,slow_ms:200,sample:1,cronexp:"12 * * * *"
#!arguments-desc=type: dual / A / AAAA / v4-only / v6-only / prefer-v4 / prefer-v6, 或 A,AAAA\ndoh: DoH URL, 多个用逗号分隔. 若使用域名而非 IP, 请在 [Host] 里为该域名加 server:syslib, 避免解析自举\nttl: 覆盖 TTL, 留空则用上游 TTL\ntimeout: 单个 DoH 请求超时(秒)\nedns: ECS IP, 或 auto(读 lastNetworkInfoEvent.CN_IP, 否则读定时刷新的直连公网 IP)\nfallback: 1=失败时回退 Surge 默认 DNS\nlog: 1=打印脚本日志\npolicy: $httpClient 策略名, 0=不指定\nflush_n / flush_ms: 指标落盘阈值(次数/毫秒), 避免每次查询都写 persistentStore\nring: 最近查询条数\nslow_ms: 超过该耗时的查询必定记入环形缓冲\nsample: 成功且不慢的查询记入环形缓冲的比例, 1=全记\ncronexp: 刷新直连公网 IP 并压缩统计的定时任务

[MITM]
hostname = %APPEND% dns.query

[Panel]
DNS-QUERY = script-name=DNS-QUERY Panel,update-interval=10

[Script]
DNS-QUERY Resolver = type=dns,engine=jsc,timeout=15,script-path=https://raw.githubusercontent.com/bluenight91/Surge-Module/main/scripts/dns-resolver.js,argument="type={{{type}}}&doh={{{doh}}}&ttl={{{ttl}}}&timeout={{{timeout}}}&edns={{{edns}}}&fallback={{{fallback}}}&log={{{log}}}&policy={{{policy}}}&flush_n={{{flush_n}}}&flush_ms={{{flush_ms}}}&ring={{{ring}}}&slow_ms={{{slow_ms}}}&sample={{{sample}}}"

DNS-QUERY Web = type=http-request,pattern=^https?:\/\/dns\.query,requires-body=true,timeout=20,script-path=https://raw.githubusercontent.com/bluenight91/Surge-Module/main/scripts/dns-web.js,argument="type={{{type}}}&doh={{{doh}}}&ttl={{{ttl}}}&timeout={{{timeout}}}&edns={{{edns}}}&fallback={{{fallback}}}&policy={{{policy}}}&flush_n={{{flush_n}}}&flush_ms={{{flush_ms}}}&ring={{{ring}}}&slow_ms={{{slow_ms}}}&sample={{{sample}}}"

DNS-QUERY Cron = type=cron,cronexp="{{{cronexp}}}",wake-system=1,timeout=20,script-path=https://raw.githubusercontent.com/bluenight91/Surge-Module/main/scripts/dns-cron.js,argument="edns={{{edns}}}&ring={{{ring}}}"

DNS-QUERY Panel = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/bluenight91/Surge-Module/main/scripts/dns-panel.js

[Host]
dns.query = 127.0.0.1
dns.google = server:syslib
dns.google.com = server:syslib
cloudflare-dns.com = server:syslib
one.one.one.one = server:syslib
mozilla.cloudflare-dns.com = server:syslib
dns.alidns.com = server:syslib
*.alidns.com = server:syslib
doh.pub = server:syslib
doh.opendns.com = server:syslib
* = script:DNS-QUERY Resolver
