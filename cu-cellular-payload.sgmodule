#!name=CU Cellular Payload
#!desc=仅由 5GPN 蜂窝控制器自动启停，请勿手动长期启用
#!category=5GPN
#!system=ios
#!arguments=ENCRYPTED_DNS_URL:https://dns.example/dns-query
#!arguments-desc=ENCRYPTED_DNS_URL：中国联通蜂窝网络使用的加密 DNS 完整 URL；安装时请替换示例值。

[Rule]
SUBNET,TYPE:CELLULAR,DIRECT

[SSID Setting]
TYPE:CELLULAR encrypted-dns-server={{{ENCRYPTED_DNS_URL}}}
