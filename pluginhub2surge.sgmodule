#!name=PluginHub2Surge
#!desc=将可莉插件中心转换给 Surge 使用; 插件中心 https://hub.kelee.one ; 请提前安装Script-Hub模块
#!category=去广告

[Body Rewrite]
http-response ^https://hub\.kelee\.one/list\.json "loon://import\?plugin=(https://kelee.one/Tool/Loon/Lpx/(.+).lpx)" "surge:///install-module?url=http://script.hub/file/_start_/$1/_end_/$2.sgmodule%3Ftype%3Dloon-plugin%26target%3Dsurge-module%26del%3Dtrue%26jqEnabled%3Dtrue"

[Header Rewrite]
http-request ^https://hub\.kelee\.one/list\.json header-del if-none-match

[MITM]
hostname = %APPEND% hub.kelee.one
